# Public source allowlist. Review new top-level paths and assets before adding them.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/docs/
!/LICENSE
!/NOTICE
!/CMakeLists.txt
!/src/
!/qml/
!/helper/
!/scripts/
!/tests/
!/assets/
!/licenses/

/src/*
!/src/*.cpp
!/src/*.h
# Objective-C++, for the one file that has to talk to AppKit.
!/src/*.mm
/qml/*
!/qml/*.qml
/helper/*
!/helper/catalog.py
!/helper/online_artwork.py
!/helper/requirements.txt
/scripts/*
!/scripts/*.sh
!/scripts/*.py
/tests/*
!/tests/*.cpp
!/tests/*.h
!/tests/*.py
/assets/*
!/assets/readme-banner.png
!/assets/sung.png
!/assets/musix.desktop
!/assets/Info.plist.in
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
/licenses/*
!/licenses/MaterialSymbols-LICENSE.txt
# Qt's own license texts, which its binaries do not ship.
!/licenses/GPL-3.0.txt
!/licenses/LGPL-3.0.txt

# Private state, credentials, build products and editor/assistant files.
**/__pycache__/
*.py[cod]
*.log
*.user
*.swp
*.swo
*~
.env
.env.*
*.pem
*.key
*.p12
*.pfx
cookies*
credentials*
secrets*
library.json
settings.json
.DS_Store
.agents/
.codex/
.idea/
.vscode/

# The README, CLAUDE.md and the docs/ guide are the only Markdown in the
# public repository.
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]
!/README.md
!/docs/*.md
!/CLAUDE.md

# macOS packaging: the release build, the downloaded and compiled payloads it
# reuses, and the artifacts it produces.
build-release/
build-packaging/
Musix-*.dmg
Musix-*-source.tar.xz
SHA256SUMS.txt
